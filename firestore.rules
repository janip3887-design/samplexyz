rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Make sure all data is denied by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'pranavrjani958@gmail.com';
    }

    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Allow users to read and create their own bookings, and update the status
    match /bookings/{bookingId} {
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /dining_bookings/{bookingId} {
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }
  }
}
